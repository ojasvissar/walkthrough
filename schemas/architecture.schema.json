{
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "rooms"],
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "floor", "path", "prop", "cue", "mnemonic", "status", "loc", "functions", "description", "dependencies"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "floor": { "type": "integer", "enum": [0, 1, 2, 3] },
          "path": { "type": "string" },
          "prop": { "enum": ["store", "terminal", "cart", "gates", "checkout", "payments", "auth", "lockers", "records", "boxes", "servers", "schemas", "graph", "response", "templates", "build", "control", "workbench", "stairs", "dust"] },
          "cue": { "type": "string" },
          "mnemonic": { "type": "string" },
          "status": { "enum": ["normal", "hot", "cycle", "dust"] },
          "loc": { "type": ["integer", "null"] },
          "functions": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
